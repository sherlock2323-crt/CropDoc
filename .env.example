# URL of the diagnosis endpoint (the Supabase Edge Function in supabase/functions/diagnose)
# Local example:  http://127.0.0.1:54321/functions/v1/diagnose
# Hosted example: https://<your-project-ref>.supabase.co/functions/v1/diagnose
VITE_DIAGNOSE_URL=

# Supabase anon (public) key - sent as the Authorization header to the Edge Function.
# Safe to expose in the browser. Leave empty if your endpoint needs no auth.
VITE_SUPABASE_ANON_KEY=
